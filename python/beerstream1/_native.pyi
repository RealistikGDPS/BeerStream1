from collections.abc import Awaitable
from collections.abc import Mapping
from typing import Any

type Row = dict[str, Any]
type Params = Mapping[str, Any] | None

class Error(Exception): ...

class MySQLError(Error):
    code: int
    sqlstate: str
    message: str

class ProtocolError(Error): ...
class ConnectionLost(Error): ...
class PoolClosed(Error): ...

class ExecuteResult:
    @property
    def last_row_id(self) -> int: ...
    @property
    def affected_rows(self) -> int: ...

class Transaction:
    def fetch_all(self, sql: str, params: Params = None) -> Awaitable[list[Row]]: ...
    def fetch_one(self, sql: str, params: Params = None) -> Awaitable[Row | None]: ...
    def fetch_val(self, sql: str, params: Params = None) -> Awaitable[Any]: ...
    def execute(self, sql: str, params: Params = None) -> Awaitable[ExecuteResult]: ...
    def commit(self) -> Awaitable[None]: ...
    def rollback(self) -> Awaitable[None]: ...
    @property
    def finished(self) -> bool: ...

class Pool:
    def __init__(
        self,
        *,
        host: str,
        port: int = 3306,
        user: str,
        password: str = "",
        database: str = "",
        min_size: int = 1,
        max_size: int = 10,
        autocommit: bool = True,
        init_command: str | None = None,
        max_idle_seconds: float = 300.0,
    ) -> None: ...
    def connect(self) -> Awaitable[None]: ...
    def close(self) -> Awaitable[None]: ...
    def fetch_all(self, sql: str, params: Params = None) -> Awaitable[list[Row]]: ...
    def fetch_one(self, sql: str, params: Params = None) -> Awaitable[Row | None]: ...
    def fetch_val(self, sql: str, params: Params = None) -> Awaitable[Any]: ...
    def execute(self, sql: str, params: Params = None) -> Awaitable[ExecuteResult]: ...
    def begin(self) -> Awaitable[Transaction]: ...
    @property
    def size(self) -> int: ...
    @property
    def idle_size(self) -> int: ...
    @property
    def waiting(self) -> int: ...
